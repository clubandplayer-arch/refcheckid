# SUPABASE_URL=https://PROJECT_REF.supabase.co
# SUPABASE_SERVER_KEY=...
# AUTH_SECRET=...at-least-32-random-characters...
# REFCHECKID_DEMO_AUTO_BOOTSTRAP=false
