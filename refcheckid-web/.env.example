# Local development: API proxy to the backend on port 4000.
NEXT_PUBLIC_API_BASE_URL=/api/v1
BACKEND_ORIGIN=http://127.0.0.1:4000

# Vercel ONLY: server-side variables. Use project settings, never commit values.
