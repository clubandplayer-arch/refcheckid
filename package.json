{
  "name": "refcheckid",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:backend": "pnpm -C refcheckid-backend dev",
    "dev:web": "pnpm -C refcheckid-web dev",
    "codespace:start": "node scripts/codespace-start.mjs",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:unit": "pnpm --filter refcheckid-backend test:unit && pnpm --filter refcheckid-web test:unit",
    "test:integration": "pnpm --filter refcheckid-backend test:integration && pnpm --filter refcheckid-web test:integration",
    "test:e2e": "pnpm --filter refcheckid-backend test:e2e",
    "test:regression": "pnpm --filter refcheckid-backend test:regression",
    "test:security": "pnpm --filter refcheckid-backend test:security",
    "test:performance": "pnpm --filter refcheckid-backend test:performance",
    "coverage": "pnpm -r coverage",
    "build": "pnpm -r build",
    "smoke": "node scripts/smoke-test.mjs",
    "migrate": "pnpm -C refcheckid-backend migrate",
    "migrate:status": "pnpm -C refcheckid-backend migrate:status",
    "migrate:rollback": "pnpm -C refcheckid-backend migrate:rollback",
    "migrate:dry-run": "pnpm -C refcheckid-backend migrate:dry-run",
    "demo:bootstrap": "pnpm -C refcheckid-backend demo:bootstrap",
    "demo:bootstrap:dry-run": "pnpm -C refcheckid-backend demo:bootstrap:dry-run",
    "demo:verify": "pnpm -C refcheckid-backend demo:verify",
    "demo:init": "node scripts/demo-init.mjs",
    "demo:diagnose-roster": "node scripts/diagnose-manager-roster.mjs",
    "test:acceptance": "pnpm -C refcheckid-backend build && node scripts/acceptance.mjs",
    "verify:cloud-bundle": "node scripts/verify-platform-cloud-bundle.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "pnpm": {
    "overrides": {
      "next>postcss": "8.5.32",
      "sharp": "0.35.5",
      "postcss>nanoid": "3.3.18",
      "postcss>source-map-js": "1.2.2"
    }
  }
}
